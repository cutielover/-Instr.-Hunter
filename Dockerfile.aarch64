# Dockerfile for running AArch64 Sifter in Linux/arm64 container
#
# Build:
#   docker build --platform linux/arm64 -f Dockerfile.aarch64 -t aarch64-sifter .
#
# Run:
#   docker run --rm -it aarch64-sifter
#   docker run --rm -it -v $(pwd)/data:/app/data aarch64-sifter

FROM ubuntu:22.04

# Install build/runtime dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Build and install Capstone 6 from source for C + Python parity.
RUN git clone --depth 1 --branch next https://github.com/capstone-engine/capstone.git /tmp/capstone && \
    cd /tmp/capstone && \
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCAPSTONE_ARCHITECTURE_DEFAULT=ON && \
    cmake --build build -j"$(nproc)" && \
    cmake --install build && \
    ldconfig && \
    cd bindings/python && pip3 install --no-cache-dir . && \
    rm -rf /tmp/capstone

RUN pip3 install --no-cache-dir --upgrade pip setuptools

WORKDIR /app
COPY . /app/

# Build only AArch64 injector in this image.
RUN make clean && make injector_aarch64 CC_AARCH64=gcc

RUN mkdir -p /app/data /app/results

# Default: AArch64 exhaustive scan (headless).
CMD ["./sifter.py", "--arch", "aarch64", "--unk", "--dis", "--sync", "--tick", "--no-gui", "-j", "8"]
