# Dockerfile for running RISC-V Sifter in QEMU via Docker
# 
# Build:
#   docker build -f Dockerfile.riscv64 -t riscv-sifter .
#
# Run:
#   docker run --rm -it riscv-sifter
#   docker run --rm -it -v $(pwd)/data:/app/data riscv-sifter

FROM --platform=linux/riscv64 riscv64/ubuntu:22.04

# Install build tools (without apt capstone - we build v6 from source for RISC-V support)
RUN apt-get update && \
    apt-get install -y --fix-missing \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip \
    || (apt-get update && apt-get install -y --fix-missing \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip) \
    && rm -rf /var/lib/apt/lists/*

# Build Capstone 6 from source (next branch) for improved RISC-V extension coverage
RUN git clone --depth 1 --branch next https://github.com/capstone-engine/capstone.git /tmp/capstone && \
    cd /tmp/capstone && \
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCAPSTONE_ARCHITECTURE_DEFAULT=ON && \
    cmake --build build -j$(nproc) && \
    cmake --install build && \
    ldconfig && \
    cd bindings/python && pip3 install --no-cache-dir . && \
    rm -rf /tmp/capstone

# Install Python dependencies
RUN pip3 install --no-cache-dir --upgrade pip setuptools

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app/

# Build
RUN make clean all

# Create data directory
RUN mkdir -p /app/data /app/results

# Default command - run exhaustive scan with GUI and real-time sync
CMD ["./sifter.py", "--unk", "--dis", "-j", "10", "--sync", "--tick"]
